# Afterglow HAProxy configuration
# Generated by kolla-ansible afterglow role

{% if enable_afterglow | bool %}
frontend afterglow_api_front
    bind {{ kolla_internal_vip_address }}:{{ afterglow_backend_port }}
    mode http
    option httplog
    option forwardfor
    default_backend afterglow_api_back

{% if afterglow_external_url is defined and kolla_external_vip_address is defined %}
frontend afterglow_ui_front
    bind {{ kolla_external_vip_address }}:{{ afterglow_frontend_port }}
    mode http
    option httplog
    default_backend afterglow_ui_back
{% endif %}

backend afterglow_api_back
    mode http
    option httpchk GET /api/v1/health
    option httplog
    balance roundrobin
{% for host in groups['afterglow'] %}
    server {{ hostvars[host]['ansible_hostname'] }} {{ 'api' | kolla_address(host) }}:{{ afterglow_backend_port }} check inter 10s rise 2 fall 5
{% endfor %}

backend afterglow_ui_back
    mode http
    option httpchk GET /
    option httplog
    balance roundrobin
{% for host in groups['afterglow'] %}
    server {{ hostvars[host]['ansible_hostname'] }} {{ 'api' | kolla_address(host) }}:{{ afterglow_frontend_port }} check inter 10s rise 2 fall 5
{% endfor %}
{% endif %}

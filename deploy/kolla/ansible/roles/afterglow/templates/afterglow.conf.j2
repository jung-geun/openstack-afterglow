# Afterglow 통합 설정 파일 (kolla-ansible 자동 생성 — 직접 수정 금지)
# Generated by kolla-ansible afterglow role

[openstack]
auth_url = "{{ keystone_public_url | default('http://localhost:5000/v3') }}"
project_name = "{{ afterglow_service_project_name }}"
project_domain_name = "Default"
user_domain_name = "Default"
region_name = "{{ openstack_region_name | default('RegionOne') }}"
interface = "{{ afterglow_openstack_interface }}"
username = "{{ afterglow_admin_keystone_user }}"
password = "{{ afterglow_admin_keystone_password }}"
service_project_id = "{{ afterglow_service_project_id }}"
ceph_monitors = "{{ afterglow_ceph_monitors }}"
manila_share_type = "{{ afterglow_manila_share_type }}"

[app]
backend_port = {{ afterglow_backend_port }}
frontend_port = {{ afterglow_frontend_port }}
secret_key = "{{ afterglow_secret_key }}"
public_api_base = "{{ afterglow_public_api_base }}"
site_name = "Afterglow"
site_description = "OpenStack VM + OverlayFS 배포 플랫폼"
logo_path = "/logo.png"
favicon_path = "/favicon.ico"
refresh_interval_ms = 5000

[cache]
redis_url = "{{ afterglow_redis_url }}"
ttl_fast = 15
ttl_normal = 30
ttl_slow = 60
ttl_static = 300
default_ttl_seconds = 30

[session]
timeout_seconds = 3600
warning_before_seconds = 300
absolute_timeout = 14400

[nova]
default_network_id = ""
default_availability_zone = "nova"
boot_volume_size_gb = 20
upper_volume_size_gb = 50
default_network_enabled = true
default_network_cidr = "192.168.0.0/24"
default_network_external_id = ""

[services]
magnum = {{ afterglow_service_magnum_enabled | lower }}
manila = {{ afterglow_service_manila_enabled | lower }}
zun = {{ afterglow_service_zun_enabled | lower }}
k3s = {{ afterglow_service_k3s_enabled | lower }}
swift = {{ afterglow_service_swift_enabled | lower }}
trove = {{ afterglow_service_trove_enabled | lower }}
barbican = {{ afterglow_service_barbican_enabled | lower }}
waygate = {{ afterglow_service_waygate_enabled | lower }}
chat = {{ afterglow_service_chat_enabled | lower }}
mcp = {{ afterglow_service_mcp_enabled | lower }}

[instance_health]
callback_base_url = "{{ afterglow_instance_health_callback_base_url }}"

[k3s]
# Shared legacy AES-256-GCM key; Drover owns its own kubeconfig encryption key.
kubeconfig_encryption_key = "{{ afterglow_kubeconfig_encryption_key | default('') }}"

[builder]
image_id = ""
flavor_id = ""
network_id = ""

[union]
layer_store_rw_share_id = "{{ afterglow_share_layer_store_rw_id }}"
layer_store_ro_share_id = "{{ afterglow_share_layer_store_ro_id }}"
manifest_store_share_id = "{{ afterglow_share_manifest_store_id }}"

[database]
url = "{{ afterglow_database_url }}"
pool_size = 5
max_overflow = 10
auto_create_tables = false

[cors]
origins = "{{ afterglow_external_url }}"

[gitlab_oidc]
enabled = false
gitlab_url = "https://gitlab.com"
client_id = ""
client_secret = "{{ afterglow_oidc_client_secret | default('') }}"
idp_id = "gitlab"
protocol_id = "openid"
redirect_uri = "{{ afterglow_external_url }}/auth/gitlab/callback"
scopes = "openid email profile read_user"

[logging]
log_file_path = "/var/log/kolla/afterglow/app.log"
log_level = "INFO"
max_bytes = 52428800
backup_count = 5
rotation_type = "size"

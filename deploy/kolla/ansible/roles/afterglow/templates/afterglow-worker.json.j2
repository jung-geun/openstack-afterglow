{
    "name": "afterglow_worker",
    "image": "{{ afterglow_backend_image }}:{{ afterglow_image_tag }}",
    "command": ["python", "-m", "app.worker"],
    "restart_policy": "unless-stopped",
    "volumes": [
        "/etc/kolla/afterglow/config.toml:/app/config.toml:ro",
        "kolla_logs:/var/log/kolla/"
    ],
    "environment": {
        "DATABASE_URL": "mysql+asyncmy://{{ afterglow_database_user }}:{{ afterglow_database_password }}@{{ database_address | default('mariadb') }}:{{ database_port | default(3306) }}/{{ afterglow_database_name }}",
        "REDIS_URL": "redis://:{{ afterglow_redis_password | default('') }}@{{ valkey_address | default('valkey') }}:{{ valkey_port | default(6379) }}/{{ afterglow_redis_db_index }}",
        "OS_PASSWORD": "{{ afterglow_admin_keystone_password }}",
        "OS_INTERFACE": "public",
        "SECRET_KEY": "{{ afterglow_secret_key }}",
        "K3S_KUBECONFIG_ENCRYPTION_KEY": "{{ afterglow_kubeconfig_encryption_key }}",
        "UNION_OS_SERVICE_PROJECT_ID": "{{ afterglow_service_project_id }}",
        "UNION_LAYER_STORE_RW_SHARE_ID": "{{ afterglow_share_layer_store_rw_id }}",
        "UNION_LAYER_STORE_RO_SHARE_ID": "{{ afterglow_share_layer_store_ro_id }}",
        "UNION_MANIFEST_STORE_SHARE_ID": "{{ afterglow_share_manifest_store_id }}",
        "UNION_METADATA_STORE_SHARE_ID": "{{ afterglow_share_metadata_store_id }}",
        "K3S_HEALTH_INTERVAL": "180"
    }
}

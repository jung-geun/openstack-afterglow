# Drover HAProxy configuration
# Generated by kolla-ansible Drover role

{% if enable_drover | bool %}
frontend drover_api_front
    bind {{ kolla_internal_vip_address }}:{{ drover_api_port }}
    mode http
    option httplog
    option forwardfor
    default_backend drover_api_back

{% if kolla_external_vip_address is defined %}
frontend drover_api_external_front
    bind {{ kolla_external_vip_address }}:{{ drover_api_port }}
    mode http
    option httplog
    option forwardfor
    default_backend drover_api_back
{% endif %}

backend drover_api_back
    mode http
    option httpchk GET /v1/health
    option httplog
    balance roundrobin
{% for host in groups['drover'] %}
    server {{ hostvars[host]['ansible_hostname'] }} {{ 'api' | kolla_address(host) }}:{{ drover_api_port }} check inter 10s rise 2 fall 5
{% endfor %}
{% endif %}

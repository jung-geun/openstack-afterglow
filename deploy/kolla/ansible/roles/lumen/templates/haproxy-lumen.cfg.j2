# Lumen HAProxy configuration
# Generated by kolla-ansible Lumen role

{% if enable_lumen | bool %}
frontend lumen_api_front
    bind {{ kolla_internal_vip_address }}:{{ lumen_api_port }}
    mode http
    option httplog
    option forwardfor
    default_backend lumen_api_back

{% if kolla_external_vip_address is defined %}
frontend lumen_api_external_front
    bind {{ kolla_external_vip_address }}:{{ lumen_api_port }}
    mode http
    option httplog
    option forwardfor
    {% if lumen_chat_api_hosts is defined and lumen_chat_api_hosts %}
    {% set host_list = lumen_chat_api_hosts if lumen_chat_api_hosts is iterable and lumen_chat_api_hosts is not string else lumen_chat_api_hosts.split(',') %}
    {% for host in host_list %}
    {% set trimmed_host = host | trim %}
    {% if trimmed_host | length > 0 %}
    acl is_lumen_chat_host req.hdr(host) -i {{ trimmed_host }}
    use_backend lumen_api_back if is_lumen_chat_host
    {% endif %}
    {% endfor %}
    {% endif %}
    default_backend lumen_api_back
{% endif %}

backend lumen_api_back
    mode http
    option httpchk GET /v1/health
    option httplog
    balance roundrobin
{% for host in groups['lumen'] %}
    server {{ hostvars[host]['ansible_hostname'] }} {{ 'api' | kolla_address(host) }}:{{ lumen_api_port }} check inter 10s rise 2 fall 5
{% endfor %}
{% endif %}

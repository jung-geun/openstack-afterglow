# Lumen TOML Configuration File
# Generated by kolla-ansible Lumen role

[keystone]
keystone_auth_url = "{{ keystone_internal_url | default('http://' ~ kolla_internal_vip_address ~ ':5000/v3') }}"
keystone_admin_username = "{{ lumen_keystone_user }}"
keystone_admin_password = "{{ lumen_keystone_password }}"
keystone_admin_project = "{{ lumen_service_project_name }}"
keystone_domain = "Default"
keystone_region_name = "{{ openstack_region_name | default('RegionOne') }}"
keystone_interface = "internal"

[database]
database_url = "mysql+aiomysql://{{ lumen_database_user }}:{{ lumen_database_password }}@{{ database_address | default(kolla_internal_vip_address) }}:{{ database_port | default(3306) }}/{{ lumen_database_name }}"
database_pool_size = 20
database_max_overflow = 10

[cache]
redis_url = "{{ lumen_redis_url }}"

[lumen]
lumen_encryption_key = "{{ lumen_encryption_key }}"
mcp_control_plane_url = "{{ lumen_mcp_control_plane_url }}"

[chat]
chat_checkpointer_postgres_url = "{{ lumen_checkpointer_postgres_url }}"
chat_memory_pgvector_url = "{{ lumen_memory_pgvector_url }}"
chat_asset_s3_endpoint = "{{ lumen_s3_endpoint_url }}"
chat_asset_s3_bucket = "{{ lumen_s3_bucket }}"
chat_asset_s3_access_key = "{{ lumen_s3_access_key }}"
chat_asset_s3_secret_key = "{{ lumen_s3_secret_key }}"
chat_asset_s3_region = "{{ lumen_s3_region }}"
chat_sandbox_api_key = "{{ lumen_sandbox_api_key }}"
chat_api_hosts = "{{ lumen_chat_api_hosts }}"

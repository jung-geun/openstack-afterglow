# Waygate HAProxy configuration
# Generated by kolla-ansible Waygate role

{% if enable_waygate | bool %}
frontend waygate_api_front
    bind {{ kolla_internal_vip_address }}:{{ waygate_api_port }}
    mode http
    option httplog
    option forwardfor
    default_backend waygate_api_back

{% if kolla_external_vip_address is defined %}
frontend waygate_api_external_front
    bind {{ kolla_external_vip_address }}:{{ waygate_api_port }}
    mode http
    option httplog
    option forwardfor
    default_backend waygate_api_back
{% endif %}

backend waygate_api_back
    mode http
    option httpchk GET /v1/health
    option httplog
    balance roundrobin
{% for host in groups['waygate'] %}
    server {{ hostvars[host]['ansible_hostname'] }} {{ 'api' | kolla_address(host) }}:{{ waygate_api_port }} check inter 10s rise 2 fall 5
{% endfor %}
{% endif %}

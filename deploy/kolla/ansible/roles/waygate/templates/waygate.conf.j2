# Waygate configuration generated by kolla-ansible

[keystone]
auth_url = "{{ keystone_internal_url | default('http://localhost:5000/v3') }}"
username = "{{ waygate_keystone_user }}"
password = "{{ waygate_keystone_password }}"
project_name = "{{ waygate_service_project_name }}"
project_domain_name = "Default"
user_domain_name = "Default"
region = "{{ openstack_region_name | default('RegionOne') }}"
interface = "internal"
insecure = {{ openstack_insecure | default(false) | bool | lower }}
cacert = "{{ openstack_cacert | default('') }}"

[database]
url = "mysql+aiomysql://{{ waygate_database_user }}:{{ waygate_database_password }}@{{ database_address | default(kolla_internal_vip_address) }}:{{ database_port | default(3306) }}/{{ waygate_database_name }}"
pool_size = 5
max_overflow = 10
connect_timeout = 10
pool_timeout = 10

[cache]
redis_url = "{{ waygate_redis_url }}"

[waygate]
callback_base_url = "{{ waygate_callback_base_url }}"
key_name = "{{ waygate_key_name }}"
default_tunnel_cidr = "{{ waygate_default_tunnel_cidr }}"
default_listen_port = {{ waygate_default_listen_port }}
encryption_key = "{{ waygate_encryption_key }}"
trusted_proxies = "{{ waygate_trusted_proxies }}"

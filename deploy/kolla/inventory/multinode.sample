# Afterglow × kolla-ansible multinode inventory sample
# Plugin services run on control nodes. Kolla HAProxy exposes their internal-VIP
# frontends and balances them across controller-local upstream ports.

[control]
ctrl01 ansible_host=10.0.0.11 ansible_user=ubuntu
ctrl02 ansible_host=10.0.0.12 ansible_user=ubuntu
ctrl03 ansible_host=10.0.0.13 ansible_user=ubuntu

[network:children]
control


[loadbalancer:children]
network

[compute]
compute01 ansible_host=10.0.0.21 ansible_user=ubuntu
compute02 ansible_host=10.0.0.22 ansible_user=ubuntu

[monitoring:children]
control

[storage]
storage01 ansible_host=10.0.0.31 ansible_user=ubuntu

[deployment]
localhost ansible_connection=local

# ── Plugin Logical Groups ─────────────────────────────────────────────────────
[afterglow:children]
control

[waygate:children]
control

[drover:children]
control

[lumen:children]
control

[palimpsest:children]
control

# ── Kolla Logical Groups ──────────────────────────────────────────────────────
[baremetal:children]
control
network
compute
storage
monitoring

[mariadb:children]
control

[rabbitmq:children]
control

[keystone:children]
control

[glance:children]
control

[nova:children]
control

[neutron:children]
control

[cinder:children]
control

[manila:children]
control

[horizon:children]
control

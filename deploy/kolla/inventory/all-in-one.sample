# Afterglow × kolla-ansible all-in-one inventory sample
# Plugin services and Kolla HAProxy run on the single control node.

[control]
localhost ansible_connection=local

[network:children]
control


[loadbalancer:children]
control

[compute:children]
control

[monitoring:children]
control

[storage:children]
control

[deployment]
localhost ansible_connection=local

# ── Plugin Logical Groups ─────────────────────────────────────────────────────
[afterglow:children]
control

[waygate:children]
control

[drover:children]
control

[lumen:children]
control

# ── Kolla Logical Groups ──────────────────────────────────────────────────────
[baremetal:children]
control

[mariadb:children]
control

[rabbitmq:children]
control

[keystone:children]
control

[glance:children]
control

[nova:children]
control

[neutron:children]
control

[cinder:children]
control

[manila:children]
control

[horizon:children]
control

#cloud-config
# Union: OpenStack VM 자동 OverlayFS 설정
# 전략: {{ strategy }}   라이브러리: {{ libraries | join(", ") }}

package_update: false
package_upgrade: false

packages:
{% if has_cephfs %}
  - ceph-common
{% endif %}
{% if has_nfs %}
  - nfs-common
{% endif %}
{% if strategy == "dynamic" %}
  - python3-pip
{% endif %}

write_files:
{% if has_cephfs %}
  # CephX 키링 파일 (CephFS 공유별)
{% for share in file_storages %}
{% if share.share_proto == "CEPHFS" %}
  - path: /etc/ceph/ceph.client.{{ share.cephx_id | shlex_quote }}.keyring
    permissions: "0600"
    content: |
      [client.{{ share.cephx_id | shlex_quote }}]
          key = {{ share.cephx_key | trim }}
{% endif %}
{% endfor %}

  # /etc/ceph/ceph.conf (모니터 주소)
  - path: /etc/ceph/ceph.conf
    content: |
      [global]
      mon host = {{ ceph_monitors }}
{% endif %}

  # OverlayFS 설정 스크립트
  - path: /opt/union/overlay_setup.sh
    permissions: "0750"
    content: |
{{ overlay_script | indent(6, first=True) }}

{% if strategy == "dynamic" %}
  # 동적 설치 스크립트 (Strategy B)
  - path: /opt/union/dynamic_install.sh
    permissions: "0750"
    content: |
{{ dynamic_script | indent(6, first=True) }}
{% endif %}

  # 환경변수 스크립트 (profile.d)
  - path: /etc/profile.d/union-env.sh
    permissions: "0644"
    content: |
      export PATH="/opt/layers/merged/usr/local/bin:/opt/layers/merged/bin:$PATH"
      export LD_LIBRARY_PATH="/opt/layers/merged/usr/local/lib:/opt/layers/merged/usr/local/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
      export PYTHONPATH="{{ pythonpath }}${PYTHONPATH:+:$PYTHONPATH}"
      export PKG_CONFIG_PATH="/opt/layers/merged/usr/local/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
{% if gpu_available %}
      export CUDA_HOME="/usr/local/cuda"
      export LD_LIBRARY_PATH="/opt/layers/merged/usr/local/cuda/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
{% endif %}

  # systemd 유닛: 매 부팅 시 OverlayFS 재구성
  - path: /etc/systemd/system/union-overlay.service
    content: |
      [Unit]
      Description=Union OverlayFS Mount
      After=network-online.target remote-fs.target
      Requires=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/opt/union/overlay_setup.sh
      TimeoutStartSec=300

      [Install]
      WantedBy=multi-user.target

{% if union_ro_share_export %}
  # envmgr 설정 (layer-store-ro export 경로 포함)
  - path: /etc/envmgr-union.conf
    permissions: "0600"
    content: |
      LAYER_STORE_RO_EXPORT="{{ union_ro_share_export }}"
{% if union_manifest_share_export %}
      MANIFEST_STORE_EXPORT="{{ union_manifest_share_export }}"
{% endif %}
{% endif %}

{% if gpu_available %}
  # GPU 스택(드라이버 + DCGM 데몬 + dcgm-exporter) 설치 스크립트
  # 베이스 이미지에 무엇이 있든 idempotent 하게 동작 — nvidia-smi/nvidia-dcgm/dcgm-exporter 가
  # 이미 있으면 각각 skip, 없으면 자동 설치.
  - path: /opt/union/install_dcgm_exporter.sh
    permissions: "0750"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      VER="{{ dcgm_exporter_version }}"
      export DEBIAN_FRONTEND=noninteractive

      # ── 1. NVIDIA 드라이버 (없을 때만) ─────────────────────────────────
      if ! command -v nvidia-smi >/dev/null 2>&1; then
        echo "[gpu-install] NVIDIA 드라이버 미발견 — ubuntu-drivers autoinstall"
        apt-get update
        apt-get install -y ubuntu-drivers-common
        ubuntu-drivers autoinstall
      fi

      # ── 2. CUDA repo + DCGM 데몬 (nvidia-dcgm) ─────────────────────────
      if ! systemctl list-unit-files nvidia-dcgm.service >/dev/null 2>&1; then
        echo "[gpu-install] nvidia-dcgm 데몬 미발견 — CUDA repo 등록 후 설치"
        . /etc/os-release
        DISTRO="ubuntu${VERSION_ID//./}"
        ARCH_DEB="$(dpkg --print-architecture)"
        KEYRING_PKG="cuda-keyring_1.1-1_all.deb"
        if [ ! -f /usr/share/keyrings/cuda-archive-keyring.gpg ]; then
          curl -fsSL "https://developer.download.nvidia.com/compute/cuda/repos/${DISTRO}/${ARCH_DEB}/${KEYRING_PKG}" \
               -o "/tmp/${KEYRING_PKG}"
          dpkg -i "/tmp/${KEYRING_PKG}"
          apt-get update
        fi
        apt-get install -y datacenter-gpu-manager
      fi
      systemctl enable --now nvidia-dcgm.service

      # ── 3. dcgm-exporter 바이너리 ──────────────────────────────────────
      if ! command -v dcgm-exporter >/dev/null 2>&1; then
        ARCH="$(uname -m)"
        case "$ARCH" in
          x86_64) ARCH=amd64 ;;
          aarch64) ARCH=arm64 ;;
          *) echo "unsupported arch: $ARCH" >&2; exit 1 ;;
        esac
        TARBALL="dcgm-exporter-${VER}-linux-${ARCH}.tar.gz"
        URL="https://github.com/NVIDIA/dcgm-exporter/releases/download/${VER}/${TARBALL}"
        TMP=$(mktemp -d)
        cd "$TMP"
        curl -fsSL "$URL" -o "$TARBALL"
        tar -xzf "$TARBALL"
        install -m 0755 dcgm-exporter /usr/local/bin/dcgm-exporter
        install -d -m 0755 /etc/dcgm-exporter
        install -m 0644 etc/default-counters.csv /etc/dcgm-exporter/default-counters.csv
        rm -rf "$TMP"
      fi

  # DCGM Exporter systemd unit — nvidia-dcgm 데몬 의존
  - path: /etc/systemd/system/dcgm-exporter.service
    content: |
      [Unit]
      Description=NVIDIA DCGM Exporter (Prometheus)
      After=network-online.target nvidia-dcgm.service
      Wants=network-online.target
      Requires=nvidia-dcgm.service

      [Service]
      Type=simple
      ExecStart=/usr/local/bin/dcgm-exporter \
        --address=0.0.0.0:9400 \
        --collectors=/etc/dcgm-exporter/default-counters.csv
      Restart=on-failure
      RestartSec=10s
      AmbientCapabilities=CAP_SYS_ADMIN

      [Install]
      WantedBy=multi-user.target
{% endif %}

{% if union_cephx_rotate_hours > 0 %}
  # CephX 키 회전 스크립트 (ExecStart 대상 — write_files 주입 필수)
  - path: /usr/local/bin/envmgr-rotate-key.sh
    permissions: "0750"
    content: |
{{ rotate_key_script | indent(6, first=True) }}

  # CephX 키 회전 systemd service
  - path: /etc/systemd/system/union-rotate-key.service
    content: |
      [Unit]
      Description=Union CephX Key Rotation
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      EnvironmentFile=-/etc/envmgr.conf
      ExecStart=/usr/local/bin/envmgr-rotate-key.sh

  # CephX 키 회전 timer
  - path: /etc/systemd/system/union-rotate-key.timer
    content: |
      [Unit]
      Description=Union CephX Key Rotation Timer

      [Timer]
      OnBootSec=30min
      OnUnitActiveSec={{ union_cephx_rotate_hours }}h
      RandomizedDelaySec=5min
      Unit=union-rotate-key.service

      [Install]
      WantedBy=timers.target
{% endif %}

{% if health_check_script %}
  # 헬스체크 스크립트
  - path: /opt/union/scripts/health-check.sh
    permissions: "0750"
    content: |
{{ health_check_script | indent(6, first=True) }}

  # 헬스체크 systemd service
  - path: /etc/systemd/system/union-health.service
    content: |
      [Unit]
      Description=Union Instance Health Check
      Wants=union-overlay.service
      After=union-overlay.service

      [Service]
      Type=oneshot
      ExecStart=/opt/union/scripts/health-check.sh
      StandardOutput=journal
      StandardError=journal

  # 헬스체크 systemd timer (5분 주기)
  - path: /etc/systemd/system/union-health.timer
    content: |
      [Unit]
      Description=Union Instance Health Check Timer

      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=5min
      Unit=union-health.service

      [Install]
      WantedBy=timers.target
{% endif %}

runcmd:
  - mkdir -p /opt/layers/{lower,upper,work,merged} /opt/union/scripts /var/lib/union
  - systemctl daemon-reload
  - systemctl enable union-overlay
  - systemctl start union-overlay
{% if health_check_script %}
  - systemctl enable --now union-health.timer
{% endif %}
{% if strategy == "dynamic" %}
  - /opt/union/dynamic_install.sh
{% endif %}
{% if gpu_available %}
  - /opt/union/install_dcgm_exporter.sh
  - systemctl daemon-reload
  - systemctl enable --now dcgm-exporter.service
{% endif %}

final_message: |
  Union VM 초기화 완료.
  전략: {{ strategy }}
  라이브러리: {{ libraries | join(", ") }}
  OverlayFS 상세: journalctl -u union-overlay --no-pager | tail -20
#!/bin/bash
# Barbican KMS plugin binary install — k3s 의 ctr 로 image pull 후 binary 추출.
#
# 사전 조건: k3s 가 install 되어 있어야 함 (`/usr/local/bin/k3s` 존재).
# k3s install 은 INSTALL_K3S_SKIP_START=true 로 binary 만 install 하고 service start 는 막은 상태.
set -euo pipefail

KMS_IMAGE="{{ kms_image }}"
KMS_BIN_DEST=/usr/local/bin/barbican-kms-plugin

log() { echo "[install_kms] $*"; }

if [ -x "$KMS_BIN_DEST" ]; then
  log "binary 이미 install 됨: $KMS_BIN_DEST"
else
  log "image pull: $KMS_IMAGE"
  /usr/local/bin/k3s ctr image pull "$KMS_IMAGE"

  log "image mount + binary 복사"
  TMPDIR=$(mktemp -d)
  trap 'rm -rf "$TMPDIR"' EXIT
  /usr/local/bin/k3s ctr image mount "$KMS_IMAGE" "$TMPDIR"
  cp "$TMPDIR/bin/barbican-kms-plugin" "$KMS_BIN_DEST"
  chmod +x "$KMS_BIN_DEST"
  /usr/local/bin/k3s ctr image unmount "$TMPDIR"
  log "install 완료: $KMS_BIN_DEST"
fi

mkdir -p /var/lib/kms
chmod 0755 /var/lib/kms

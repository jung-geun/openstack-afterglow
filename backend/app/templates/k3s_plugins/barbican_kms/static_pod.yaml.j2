---
# Barbican KMS Plugin — Host Static Pod
# kubelet이 apiserver 의존 없이 직접 띄움 (chicken-and-egg 데드락 해소).
# /var/lib/rancher/k3s/agent/pod-manifests/ 경로의 매니페스트는 kubelet에 의해 자동 감시·생성됨.
apiVersion: v1
kind: Pod
metadata:
  name: barbican-kms
  namespace: kube-system
  labels:
    app: barbican-kms
    component: kms-provider
spec:
  hostNetwork: true
  priorityClassName: system-node-critical
  containers:
    - name: barbican-kms-plugin
      image: {{ barbican_kms_image }}
      args:
        - /bin/barbican-kms-plugin
        - --cloud-config=/etc/config/cloud.conf
        - --key-id={{ kek_id }}
        - --listen=/var/lib/kms/kms.sock
      imagePullPolicy: IfNotPresent
      securityContext:
        privileged: true
      volumeMounts:
        - name: cloud-config
          mountPath: /etc/config/cloud.conf
          readOnly: true
        - name: kms-socket
          mountPath: /var/lib/kms
  volumes:
    - name: cloud-config
      hostPath:
        path: /etc/kubernetes/barbican-cloud.conf
        type: File
    - name: kms-socket
      hostPath:
        path: /var/lib/kms
        type: DirectoryOrCreate

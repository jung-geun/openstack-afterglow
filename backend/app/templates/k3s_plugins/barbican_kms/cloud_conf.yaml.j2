[Global]
auth-url={{ auth_url }}
region={{ region }}
username={{ username }}
password={{ password }}
domain-name={{ user_domain_name }}
tenant-name={{ project_name }}
{% if project_domain_name %}
project-domain-name={{ project_domain_name }}
{% endif %}
{% if ca_file %}
ca-file={{ ca_file }}
{% endif %}

[KeyManager]
use-barbican=true

# Afterglow 통합 설정 파일
# 이 파일을 afterglow.conf로 복사해 수정하면 백엔드와 프론트엔드 전체 설정이 변경됩니다.
# 우선순위: 환경변수 > afterglow.conf > config.toml(레거시) > 기본값
#
# 오버라이드: 같은 디렉토리에 `afterglow.<name>.conf`, `afterglow.<name>.toml`,
# 또는 레거시 `config.<name>.toml` 을 두면 이 파일 위에 딥 머지된다.
#  - 예) config.gpu.toml  ← GPU 디바이스 맵 (config.gpu.toml.example 참고)
#  - 알파벳순으로 적용되어 뒤 파일이 앞을 이긴다. dict는 재귀 병합, 리스트는 덮어쓰기.

[openstack]
auth_url = "http://keystone.example.com:5000/v3"
project_name = "admin"
project_domain_name = "Default"
user_domain_name = "Default"
region_name = "RegionOne"
# interface = "internal"          # OpenStack 엔드포인트 타입: "internal" | "public" | "admin" (기본값: internal)
username = "admin"
password = "change-me-in-production"
# insecure = false                # 자체 서명 인증서 사용 시 true로 설정
# cacert = "/path/to/ca.pem"     # CA 인증서 경로 (insecure=false일 때 사용)

# Swift (Object Storage) 설정
swift_endpoint = ""               # 서비스 카탈로그 대신 직접 지정할 경우 (예: https://s3.example.com/swift/v1/AUTH_%(project_id)s)
swift_upload_timeout = 600  # Swift 업로드 타임아웃 (초)
trash_retention_days = 30   # 휴지통 보관 기간 (일). 이 기간 이후 오브젝트·버킷이 자동 영구 삭제됨.

# Manila 설정
manila_endpoint = ""              # 서비스 카탈로그 대신 직접 지정할 경우
manila_share_network_id = ""
manila_share_type = "cephfs"
manila_nfs_share_type = "cephfsnfstype"  # NFS 프로토콜용 share type
manila_nfs_root_squash = true      # NFS access rule root_squash 강제 (보안 기본값)
manila_nfs_sec_flavor = "sys"      # NFS 인증 flavor: "sys"(기본) | "krb5"(Kerberos)
manila_cephx_key_timeout_seconds = 300  # CephX key 발급 폴링 최대 대기(초). devstack 환경에선 300 이상 권장.

# Union Mount 전용 service 프로젝트 UUID (Manila share + Builder VM이 이 프로젝트에 생성됨)
# 미설정 시 prebuilt 라이브러리 빌드/마운트 경로에서 RuntimeError 발생
service_project_id = ""

# Ceph 모니터 (cloud-init CephFS 마운트용, 콤마 구분)
ceph_monitors = ""

[app]
backend_port = 8000
frontend_port = 3000
secret_key = "change-me-in-production"

# 사이트 표시 이름 및 설명 (로그인 화면 · 네비게이션 바)
site_name = "Afterglow"
site_description = "OpenStack VM + OverlayFS 배포 플랫폼"

# 로고 및 파비콘 경로 (frontend/static/ 기준, SvelteKit이 /로 서빙)
logo_path = "/logo.png"
logo_dark_path = "/logo-white.png"   # light theme/login background용 어두운 로고
logo_light_path = "/logo-dark.png" # dark theme/login background용 밝은 로고
favicon_path = "/favicon.ico"

# 프론트엔드 대시보드 자동 새로고침 간격 (밀리초)
# 권장 범위: 3000 ~ 30000
refresh_interval_ms = 5000

# 초대 이메일 링크 생성에 사용할 프론트엔드 기본 URL (예: https://afterglow.example.com)
frontend_base_url = ""

# 브라우저에서 호출할 API Origin (예: https://afterglow.example.com).
# 비워두면 frontend_base_url, 첫 CORS origin, 개발 backend_port 순서로 유도합니다.
public_api_base = ""

# 리버스 프록시 신뢰 CIDR (쉼표 구분). 이 대역에서 온 요청의 X-Forwarded-For / X-Real-IP
# 헤더를 신뢰해 실제 클라이언트 IP 를 추출한다. 기본값은 loopback 전용.
# Docker Compose + HAProxy 프로필 사용 시 HAProxy 컨테이너의 실제 IP 대역을 명시:
#   예) "127.0.0.1/32,::1/128,172.18.0.0/16"  ← docker network inspect 로 확인
# Docker Desktop macOS 환경: 192.168.65.0/24 추가 필요
# ⚠ /12 처럼 넓은 CIDR 은 내부 컨테이너가 헤더를 위조할 수 있어 위험함
trusted_proxies = "127.0.0.1/32,::1/128"

[cache]
redis_url = "redis://redis:6379/0"

# Redis Sentinel HA (false = 단일 Redis, true = Sentinel 고가용성 모드)
# K8s 배포 시 generate_k8s.py 가 sentinel_enabled = true 로 자동 설정한다.
sentinel_enabled = false
sentinel_master_name = "mymaster"
sentinel_hosts = ""  # 콤마 구분 "host:port" (예: "sentinel-a:26379,sentinel-b:26379")

# TTL 티어 (초). 리소스 변경 빈도에 따라 분류.
ttl_fast = 15       # 인스턴스, 볼륨, 플로팅IP 등 빈번히 변하는 리소스
ttl_normal = 30     # 네트워크, 라우터, 토폴로지, 대시보드
ttl_slow = 60       # 키페어, 보안그룹, 관리자 프로젝트/그룹/역할
ttl_static = 300    # 이미지, 플레이버, 토큰 검증
default_ttl_seconds = 30  # TTL 티어 미지정 리소스의 기본 캐시 TTL (초)

# 캐시 백엔드: "redis" 또는 "valkey" (v1 은 동일 redis-py 클라이언트 사용)
backend = "redis"
# Dynamic TTL 조정 임계치 (시간당 mutation 횟수)
dynamic_threshold_low = 5
dynamic_threshold_high = 20

# 3-tier TTL 카테고리 (초) — 데이터 특성 기반 분류
ttl_identity_stable = 86400  # 개인 프로필, role/group 멤버십 (1일)
ttl_catalog_slow = 900       # flavors, image 메타, 데이터스토어, 클러스터 템플릿 (15분)
ttl_project_meta = 300       # keypair, SG 정의, 네트워크 메타 (5분)
ttl_operational_live = 30    # instances/volumes/FIP/컨테이너 상태 (30초)
ttl_admin_overview = 60      # admin 토폴로지, 하이퍼바이저 (60초)
ttl_auth_token = 60          # Keystone 토큰 검증 결과 (60초)

[session]
# 세션 유지 시간 (초). 이 시간이 지나면 재로그인 필요.
# Keystone 토큰 만료 시간보다 짧게 설정 권장 (Keystone 기본값: 3600초)
timeout_seconds = 3600
# JWT access/refresh 토큰 수명 (초)
jwt_access_ttl = 900      # access 토큰 (기본 15분)
jwt_refresh_ttl = 604800  # refresh 토큰 (기본 7일)
# 토큰 출처 IP/기기 바인딩 검사 모드
#   off    — 검사 없음
#   log    — 불일치 로깅만, 차단 없음
#   subnet — IP가 다른 /24(IPv4)·/64(IPv6) 대역이면 차단 (기본값)
#   strict — IP 정확 불일치 또는 기기 지문 불일치 시 차단
token_ip_binding_mode = "subnet"

[security]
# system:all scope 기반 admin 인증 (보안 강화 권장)
# True: admin 프로젝트 role도 시스템 admin으로 인정 (마이그레이션 호환 모드 — 권한 자기복제 허용)
# False: system:all scope만 인정 (권장). 변경 전 scripts/bootstrap_system_admin.py 실행 필요.
admin_legacy_project_policy = false
# 로그인 브루트포스 방어
login_max_attempts = 10       # 연속 실패 후 계정 잠금 임계값
login_lockout_seconds = 300   # 기본 잠금 시간 (초)
login_backoff_base = 2        # 지수 백오프 밑수 (실패 반복 시 잠금 시간 증가)

[nova]
default_network_id = ""
default_availability_zone = "nova"
boot_volume_size_gb = 20
upper_volume_size_gb = 50

# 프로젝트별 기본 네트워크 자동 생성/관리
default_network_enabled = true                # true 시 사용자 로그인 시 기본 네트워크 자동 생성
default_network_cidr = "192.168.0.0/24"       # 자동 생성 네트워크의 서브넷 CIDR
default_network_external_id = ""              # 기본 네트워크 라우터에 연결할 외부 네트워크 ID

# [gpu] 섹션은 `config.gpu.toml` 로 분리되어 있습니다.
# → 샘플: config.gpu.toml.example
# → 사용: cp config.gpu.toml.example config.gpu.toml
# 같은 디렉토리에 두면 오버라이드 머지로 자동 적용됩니다.


[services]
# 선택적 OpenStack 서비스 활성화 여부 (false면 라우터 미등록 + 사이드바 숨김)
magnum = false      # K8s 클러스터 (Heat 포함)
manila = false      # 공유 파일 시스템
zun = false         # 컨테이너
k3s = false         # k3s 자체 관리 Kubernetes 클러스터
swift = false       # 오브젝트 스토리지
trove = false       # DBaaS (Database as a Service)
barbican = false    # Key Manager (시크릿/인증서 관리)
vpn = false         # WireGuard VPN 게이트웨이 (활성화 시 [vpn] 섹션 설정 필수)
chat = false        # AI 채팅 — LibreChat 임베드 (활성화 시 [chat] 섹션 설정 필수)

[k3s]
# ─────────────────────────────────────────────────────────────────────────────
# k3s 자체 관리 Kubernetes 클러스터 설정 (services.k3s = true 시 활성화)
# ─────────────────────────────────────────────────────────────────────────────
#
# 클러스터 생성 UI(Drover)에서 OS 타입을 선택할 수 있습니다:
#   - Ubuntu  (기본): cloud-init 기반. server_image_id에 Ubuntu 22.04+ 이미지 UUID 입력.
#   - CoreOS  (FCOS): Ignition 기반. fcos_image_id에 Fedora CoreOS 이미지 UUID 입력.
#
# 두 OS 타입을 동시에 지원하려면 server_image_id와 fcos_image_id 모두 설정하면 됩니다.
# 어느 한쪽만 설정해도 해당 타입 클러스터만 정상 동작합니다.
#
# [Ubuntu 이미지 준비]
#   openstack image list --name ubuntu   # 이미지 UUID 확인
#
# [Fedora CoreOS 이미지 준비]
#   1) https://fedoraproject.org/coreos/download/ 에서 OpenStack QCOW2 다운로드
#   2) openstack image create --file fedora-coreos-*.qcow2 \
#        --disk-format qcow2 --container-format bare "fedora-coreos-42" \
#        --property hw_disk_bus=virtio --property hw_vif_model=virtio
#   3) 출력된 UUID를 fcos_image_id에 입력
#
version = "v1.34.6+k3s1"       # k3s 버전 (예: v1.34.6+k3s1)
server_flavor_id = ""          # 서버(control plane) 노드 플레이버 ID
default_agent_flavor_id = ""   # 에이전트(worker) 노드 기본 플레이버 ID

# ── Ubuntu 기반 클러스터 (os_type = ubuntu, 기본값) ──────────────────────────
# Glance에 등록된 Ubuntu 22.04 LTS 이상 이미지 UUID
# cloud-init으로 k3s 자동 설치. SSH keypair 사용 가능.
server_image_id = ""

# ── Fedora CoreOS 기반 클러스터 (os_type = fcos) ─────────────────────────────
# Glance에 등록된 Fedora CoreOS (FCOS) 이미지 UUID
# Ignition JSON으로 k3s 설치. SSH 기본 비활성화 (보안 강화).
# FCOS는 config_drive=true로 부팅해야 Ignition이 주입됨 (자동 처리됨).
fcos_image_id = ""

callback_base_url = ""         # 서버 VM이 콜백할 백엔드 URL (예: http://10.0.0.1:8000)
                               # Docker Compose 환경: 호스트 IP를 직접 입력 (localhost 불가)
kubeconfig_encryption_key = "" # AES-256-GCM 키 (32바이트 hex)
                               # 생성: openssl rand -hex 32
boot_volume_size_gb = 30       # 노드 루트 볼륨 크기 (GB). FCOS는 30GB 이상 권장.

# ─────────────────────────────────────────────────────────────────────────────
# Cloud Provider OpenStack 플러그인 (cloud-provider-openstack, Magnum 제외)
# 각 플러그인은 독립적으로 활성화 가능. OpenStack 인증 정보([openstack] 섹션)를 공유.
# ─────────────────────────────────────────────────────────────────────────────

# OCCM (OpenStack Cloud Controller Manager)
# 역할: K8s 노드 초기화, Service LoadBalancer(Octavia), 라우팅
# 활성화 시: --disable-cloud-controller + --kubelet-arg=cloud-provider=external 자동 설정
occm_enabled = false
occm_image = "registry.k8s.io/provider-os/openstack-cloud-controller-manager:v1.34.1"
occm_floating_network_id = ""  # Octavia LB에 할당할 Floating IP 네트워크 ID
occm_public_network_name = ""  # 퍼블릭 네트워크 이름 (라우팅용)

# Cinder CSI Plugin
# 역할: PersistentVolumeClaim → Cinder 블록 스토리지 자동 프로비저닝
# StorageClass "cinder" (기본값)가 생성됨. OCCM 없이도 독립 동작.
cinder_csi_enabled = false
cinder_csi_image = "registry.k8s.io/provider-os/cinder-csi-plugin:v1.34.1"
cinder_csi_default_az = "nova" # 볼륨 생성 기본 AZ

# Manila CSI Plugin
# 역할: ReadWriteMany PVC → Manila NFS 공유 파일시스템 자동 프로비저닝
# NFS CSI 드라이버가 의존성으로 함께 배포됨. StorageClass "manila-nfs" 생성.
manila_csi_enabled = false
manila_csi_image = "registry.k8s.io/provider-os/manila-csi-plugin:v1.34.1"
manila_csi_nfs_image = "registry.k8s.io/sig-storage/nfsplugin:v4.9.0"
manila_csi_share_protocol = "NFS"  # "NFS" 또는 "CEPHFS"

# Keystone Webhook Auth
# 역할: kubectl → Keystone 토큰으로 K8s 인증 연동 (별도 kubeconfig 불필요)
# 활성화 시: self-signed TLS 인증서 자동 생성 + K3s API 서버 webhook 설정
keystone_auth_enabled = false
keystone_auth_image = "registry.k8s.io/provider-os/k8s-keystone-auth:v1.34.1"
# keystone_auth_policy = ""  # JSON 정책 문자열 (빈값 = 인증만 활성화, 인가는 K8s RBAC 사용)

# Octavia Ingress Controller
# 역할: Ingress → Octavia 로드밸런서 (ingressClassName: openstack). K3s Traefik과 공존.
# 주의: subnet_id는 LB가 배치될 서브넷 ID (필수)
octavia_ingress_enabled = false
octavia_ingress_image = "registry.k8s.io/provider-os/octavia-ingress-controller:v1.34.1"
octavia_ingress_subnet_id = ""          # LB 배치 서브넷 ID (필수)
octavia_ingress_floating_network_id = "" # HTTPS Ingress용 Floating IP 네트워크 ID (선택)

# Barbican KMS Plugin
# 역할: K8s Secret at-rest 암호화 (etcd 데이터를 Barbican KEK으로 봉인)
#
# 아키텍처 (§ 26.x — PR0/PR3/PR1/PR2 재설계):
# - PR3: k3s 외부 systemd service 로 분리 (host static pod 패턴이 K3s 1.34 데드락)
# - PR1: cluster 별 application credential 인증 (admin password 노출 차단)
# - PR2: per-project KEK auto-provisioning (cluster 생성 시 owner project 의
#        Barbican 에서 'afterglow-k8s-kek' 자동 발급/재사용)
#
# 사전 조건: 각 사용자 project 의 manager user 가 Barbican secret 발급 권한
#   (member role + Barbican policy 의 creator 접근). 별도 설정 보통 불필요.
barbican_kms_enabled = false
barbican_kms_image = "registry.k8s.io/provider-os/barbican-kms-plugin:v1.34.1"
# barbican_kms_kek_id: 비워두면 PR2 동적 발급 (권장 — multi-tenant 보안).
# 채워두면 ensure_project_kek 실패 시 graceful degrade fallback 으로만 사용.
# (모든 cluster 가 같은 KEK 공유하게 되어 multi-tenant 의미 약화 → 권장 안 함)
barbican_kms_kek_id = ""

# API LB (K3s API 서버용 Octavia LB)
# LB-first 전략: VM 생성 전에 LB(listener+pool)를 완성하고, 콜백 후 member만 추가.
# 모드 A — provider 네트워크에 VIP 직접 생성 (FIP 불필요, 권장):
#   api_lb_enabled = true
#   api_lb_vip_network_id = "<provider-network-uuid>"
# 모드 B — tenant 서브넷 VIP + Floating IP (하위호환):
#   api_lb_enabled = true
#   api_lb_floating_network_id = "<external-network-uuid>"
api_lb_enabled = false
api_lb_vip_network_id = ""            # [모드 A] provider 네트워크 ID (설정 시 FIP 불필요)
api_lb_floating_network_id = ""       # [모드 B] FIP 할당 외부 네트워크 ID (미설정 시 occm_floating_network_id 사용)

# LB 네트워크 분리
# OCCM Service LB(type: LoadBalancer) + API LB(6443) 공통 VIP 서브넷
# 미설정 시 클러스터 VM과 동일 네트워크의 첫 서브넷 사용
# 설정 시 두 서브넷이 같은 라우터에 연결되어 있어야 L3 라우팅이 가능함
lb_subnet_id = ""  # 예: "subnet-uuid-for-external-lb"

# 인증서 회전 (Certificate Rotation)
# k3s는 재시작 시 만료 90일 이내 인증서를 자동 갱신한다.
# Afterglow는 K8s Job(hostPID + nsenter)으로 SSH 없이 k3s restart를 트리거한다.
cert_rotation_node_timeout_sec = 300    # 노드당 Ready 대기 최대 시간 (초)
cert_rotation_job_image = "registry.k8s.io/util-linux/util-linux:latest"  # nsenter 포함 이미지

# Stampede 노드 오토스케일 (GCP Autopilot 유사 모드)
# 사용자가 pod를 배포하면 드로버가 자동으로 노드(VM)를 확장/축소한다.
stampede_enabled = false                        # 전역 활성화 여부
stampede_interval = 60                          # reconcile 주기 (초)
stampede_scale_down_threshold = 0.5             # 노드 사용률 이 값 미만이면 scale-down 후보
stampede_scale_down_window = 600                # scale-down 안정화 대기 시간 (초, 연속 유휴 확인)
stampede_scale_up_cooldown = 120                # scale-up 쿨다운 (초)
stampede_scale_down_cooldown = 300              # scale-down 쿨다운 (초)
stampede_resource_headroom_factor = 0.3         # flavor 선택 시 기존 부하 가중치 (0~1)


[worker_runtime]
# Background worker runtime manager.
# Default static mode preserves the current fixed Compose/Kubernetes/Kolla worker manifests
# (the [worker_runtime] block is inert; workers run from those manifests).
# docker/kubernetes modes are explicit opt-in and never auto-detected.
#
# Activation:
#   docker mode     -> use docker-compose.worker-runtime.yml overlay (fills the [worker_runtime.docker] block below)
#   kubernetes mode -> set mode via Helm values-<env>.yaml (workerRuntime.mode + kubernetes.rbac.create=true)
# At the default max_replicas = 1 the manager can only toggle 0<->1 (pause/resume) via
#   PATCH /api/v1/admin/worker-runtime/desired; true multi-replica scaling needs a higher
#   max_replicas AND verified worker concurrency-safety.
mode = "static"                  # static | docker | kubernetes
reconcile_interval = 30           # seconds; 0 disables the backend reconcile loop
fail_closed = true                # reserved: parsed but not yet consumed by adapters

[worker_runtime.workers.drover]
enabled = true
desired_replicas = 1
max_replicas = 1                  # raise only after verifying parallel drover safety
module = "app.worker"

[worker_runtime.workers.notion_worker]
enabled = true
desired_replicas = 1
max_replicas = 1
module = "app.notion_worker"

[worker_runtime.docker]
# Docker mode requires the backend container to have an explicit Docker socket mount
# plus host-visible bind source paths. These are intentionally empty by default so
# opt-in Docker mode reports unavailable instead of creating broken containers.
socket_path = ""                  # e.g. /var/run/docker.sock
image = ""                        # required when mode = "docker"
network = ""                      # optional Docker network name
config_mount = "/app/afterglow.conf"
config_host_path = ""             # host path for afterglow.conf, not backend-container path
gpu_config_mount = "/app/config.gpu.toml"
gpu_config_host_path = ""         # optional host path for config.gpu.toml
logs_mount = "/app/logs"
logs_host_path = ""               # optional host path for worker logs
env_allowlist = "AFTERGLOW_ENV,AFTERGLOW_ALLOW_INSECURE,SECRET_KEY,OS_PASSWORD,DATABASE_URL,K3S_KUBECONFIG_ENCRYPTION_KEY,PROMETHEUS_PASSWORD,GITLAB_OIDC_CLIENT_SECRET,NOTION_CONFIG_ENCRYPTION_KEY"

[worker_runtime.kubernetes]
namespace = "afterglow"
service_account_token_path = "/var/run/secrets/kubernetes.io/serviceaccount/token"
service_account_ca_path = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
manage_deployments = false        # v1: must remain false; managed Deployment creation is not exposed


[builder]
# 라이브러리 빌드 전용 영구 VM 설정 (SSH 기반 빌드 파이프라인)
# services.manila = true 환경에서 라이브러리 레이어를 미리 빌드할 때 사용
image_id = ""       # 레거시 24.04 빌더 VM 이미지 ID (ubuntu_24_04_image_id 미설정 시 fallback)

# Admin layer workflow canonical Ubuntu image IDs.
# 빌더 VM과 기본 소비 VM 모두 같은 매핑을 사용합니다.
# ubuntu_24_04_image_id가 비어 있으면 image_id → nova.server_image_id 순으로 fallback합니다.
ubuntu_18_04_image_id = ""
ubuntu_20_04_image_id = ""
ubuntu_22_04_image_id = ""
ubuntu_24_04_image_id = ""
flavor_id = ""      # 빌더 VM 플레이버 ID
network_id = ""     # 빌더 VM 네트워크 ID (미설정 시 nova.default_network_id 사용)

# 영구 Builder VM (SSH 기반 빌드 파이프라인)
# persistent_server_id: 기존 VM이 있으면 Nova UUID 입력 (없으면 최초 빌드 시 자동 생성)
persistent_server_id = ""
# ssh_user: Builder VM SSH 사용자 (Ubuntu 이미지 기본값 "ubuntu")
ssh_user = "ubuntu"
# ssh_key_path: SSH 개인키 파일 경로
#   - K8s: Secret 볼륨으로 /etc/afterglow/ssh/builder.key 에 마운트
#   - 로컬/Compose: 최초 생성 시 이 경로에 자동 저장
ssh_key_path = "/etc/afterglow/ssh/builder.key"
# ssh_private_key: SSH 개인키 내용 (PEM 형식)
#   - K8s 배포 전용: generate_k8s.py가 이 값을 secret.yaml의 BUILDER_SSH_PRIVATE_KEY 로 출력
#     → deployment.yaml이 afterglow-secrets의 BUILDER_SSH_PRIVATE_KEY 를 ssh_key_path 경로에 마운트
#   - 로컬 환경에서는 이 필드를 비워 두거나 생략 (파일을 직접 관리)
#   - 생성: ssh-keygen -t ed25519 -C "afterglow-builder" -f builder.key
ssh_private_key = ""
# ssh_host: Builder VM의 Floating IP (비워두면 Nova에서 자동 조회)
ssh_host = ""
# floating_network_id: FIP 할당용 외부 네트워크 ID (ssh_host 미설정 시 필수)
floating_network_id = ""
# build_timeout: 빌드 SSH 명령 최대 대기 시간 (초, 기본값 3600)
build_timeout = 3600
# layer_share_size_gb: 레이어 빌드 시 동적 생성되는 Manila NFS share 용량 (GB, 기본값 20)
# torch 등 대용량 패키지를 포함하는 레이어는 더 크게 설정 권장
layer_share_size_gb = 20


[union]
# Union Mount 레이어 시스템 — 레이어별 동적 Manila share 방식 (per-layer-share)
# 빌드 시 레이어마다 NFS share를 자동 생성·봉인(RO)하므로 아래 share ID는 미설정 허용.
# manifest-store는 여전히 사전 생성 share 사용.
layer_store_rw_share_id = ""    # (레거시) 단일 layer-store-rw share ID (미설정 시 무시)
layer_store_ro_share_id = ""    # (레거시) 단일 layer-store-ro share ID (미설정 시 무시)
manifest_store_share_id = ""    # manifest-store Manila share ID


[vpn]
# WireGuard VPN 게이트웨이 (Phase 1 — 서버 프로비저닝 + 클라이언트 관리)
# 테넌트 프로젝트의 provider 네트워크에 WireGuard bastion VM을 부팅한다.
# services.vpn = true 여야 라우터가 등록되고 사이드바에 노출된다.
provider_network_id = ""       # VPN VM이 부팅될 provider 네트워크 ID (필수)
flavor_name = "cpu.1c_2g"      # flavor 이름으로 해석 (flavor_id 설정 시 이름 조회 생략)
flavor_id = ""                 # 설정 시 이름 조회 없이 바로 사용
image_id = ""                  # VPN VM 부팅 이미지 ID (Ubuntu 22.04+, 필수)
floating_network_id = ""       # 설정 시 FIP 할당, 미설정 시 provider fixed IP를 endpoint로 사용
callback_base_url = ""         # 에이전트가 콜백할 백엔드 URL (예: http://10.0.0.1:8000)
                               # Docker Compose 환경: 호스트 IP를 직접 입력 (localhost 불가)
key_name = ""                  # VPN VM에 연결할 Nova keypair 이름 (옵션, SSH 디버깅용)
default_tunnel_cidr = "10.8.0.0/24"  # WireGuard 터널 서브넷 기본값 (신규 서버 생성 시 사용)
default_listen_port = 51820    # WireGuard UDP 리슨 포트 기본값
# 클라이언트 private key 암호화 키는 k3s.kubeconfig_encryption_key 를 재사용합니다 (신규 시크릿 불필요)


[notion]
# Notion 연동 설정 (선택적)
# config_encryption_key = ""  # Notion 설정 암호화 키 (미설정 시 k3s.kubeconfig_encryption_key 재사용)


[logging]
# 파일 로그 설정 (미설정 시 stdout 전용 출력)
# log_file_path = ""            # 로그 파일 경로 (예: "/var/log/afterglow/app.log")
# log_level = "INFO"            # 로그 레벨: DEBUG, INFO, WARNING, ERROR, CRITICAL
# max_bytes = 10485760          # 파일 최대 크기 (바이트, rotation_type = "size"일 때)
# backup_count = 5              # 보관할 로그 파일 수
# rotation_type = "size"        # "size" (크기 기반) 또는 "time" (시간 기반)
# rotation_when = "midnight"    # time rotation 기준: midnight, H, D, W0-W6
# rotation_interval = 1         # time rotation 간격


[gpu]
# GPU 가용량을 사용자에게 노출할지 여부
# true 시 VM 생성 위자드의 GPU Flavor 선택에서 타입별 잔여 수량이 표시됨
available_visible = false


[database]
# k3s 클러스터 영속화용 MariaDB/MySQL 연결 URL (선택적)
# 미설정 시 기존 Redis 방식으로 동작
# url = "mysql+aiomysql://afterglow:password@mariadb.example.com:3306/afterglow"
url = ""
# 커넥션 풀 설정
pool_size = 5
max_overflow = 10
# 앱 시작 시 테이블 자동 생성 (개발/테스트용, 운영에서는 false 후 migrations/ SQL 수동 실행 권장)
auto_create_tables = true
# MySQL TCP/핸드셰이크 대기 시간(초). 일시적 네트워크 지연을 견디려면 늘릴 것
connect_timeout = 10
# 커넥션 풀에서 빈 커넥션을 기다리는 시간(초)
pool_timeout = 10
# OperationalError 발생 시 모든 DB 호출을 즉시 차단할 시간(초). 짧으면 회복이 빠르고, 길면 죽은 DB에 재시도 비용을 줄임
unhealthy_seconds = 15
# 자동 DB 백업 실행 시각 (cron 표현식, notion-worker가 APScheduler로 실행)
# db_auto_backup_cron = "0 3 * * *"   # 매일 새벽 3시

[monitoring]
# Prometheus 서버 주소 (K8s 환경에서는 in-cluster DNS 권장)
prometheus_base_url = "http://prometheus:9090"
prometheus_username = ""        # basic auth 사용자명 (미사용 시 빈 문자열)
prometheus_password = ""        # basic auth 비밀번호 (secret.yaml에서 주입)
# Prometheus Service Discovery 인증 토큰 (/api/v1/sd/prometheus/targets)
sd_token = ""                   # secret.yaml에서 주입
# Prometheus scrape 대역 CIDR (예: 10.0.0.0/8). monitoring API 사용 시 필수.
scrape_cidr = ""
# 프로젝트/인스턴스 생성 시 모니터링 Security Group 자동 부착
auto_sg_enabled = true
node_exporter_sg_name = "node_exporter"   # node_exporter ingress SG 이름 (tcp/9100)
dcgm_exporter_sg_name = "dcgm_exporter"  # dcgm_exporter ingress SG 이름 (tcp/9400, GPU 전용)
# VM 메트릭 수집 포트 (기본값 유지 권장)
node_exporter_port = 9100       # VM에 설치된 node_exporter 포트 (기본 9100)
dcgm_exporter_port = 9400       # GPU VM의 dcgm_exporter 포트 (기본 9400)
libvirt_exporter_port = 9177    # compute 노드 libvirt_exporter 포트 (기본 9177, kolla enable_prometheus_libvirt_exporter)
gpu_flavor_prefix = "gpu."      # GPU 노드 판별 flavor prefix (예: "gpu." → gpu.a100x1_80gb 등)
# Grafana 연동
grafana_base_url = ""           # Grafana 외부 URL (예: https://grafana.example.com)
                                # 이 값은 frontend 의 PUBLIC_GRAFANA_BASE 로도 주입되어 CSP frame-src 에 포함됩니다

# === Prometheus scrape 설정 참고 (K8s ConfigMap에서 자동 생성 — 직접 수정 불필요) ===
# scrape_configs:
#   - job_name: "instances-node"
#     http_sd_configs:
#       - url: "http://backend:8000/api/v1/sd/prometheus/targets"
#         refresh_interval: 30s
#         authorization:
#           credentials_file: /etc/prometheus/sd-token
#   - job_name: "instances-dcgm"
#     http_sd_configs:
#       - url: "http://backend:8000/api/v1/sd/prometheus/targets"
#         refresh_interval: 30s

[monitoring.dashboards]
# Grafana 대시보드 UID. monitoring/grafana/provisioning/dashboards/ 에 JSON이 프로비저닝되어야 함.
node_uid = "afterglow-node"
rabbitmq_uid = "afterglow-rabbitmq"
mysqld_uid = "afterglow-mysqld"
memcached_uid = "afterglow-memcached"
etcd_uid = "afterglow-etcd"
haproxy_uid = "afterglow-haproxy"
libvirt_uid = "afterglow-libvirt"
openstack_uid = "afterglow-openstack"
ceph_uid = "afterglow-ceph"
instance_cpu_uid = "afterglow-instance-cpu"   # CPU 전용 인스턴스 per-VM 대시보드
instance_gpu_uid = "afterglow-instance-gpu"   # GPU 인스턴스 per-VM 대시보드


[chat]
# 빌트인 AI 채팅 (litellm 라우팅 + 모델별 가중 크레딧 + 월 쿼터).
# services.chat = true 로 활성화한다. 프로바이더 API 키는 이 파일이 아니라
# 관리자 페이지에서 등록되어 DB에 AES-256-GCM(k3s_kubeconfig_encryption_key)으로 암호화 저장된다.
default_model = ""              # 기본 모델명 (활성 llm_models 카탈로그의 model_name과 일치해야 함)
credit_per_usd = 1000.0         # 크레딧 환산율: 1 USD = N 크레딧 (예: $0.001 = 1 크레딧)
default_monthly_quota = 100000.0  # 신규 지갑 기본 월 쿼터(크레딧). 0 = 무제한
stream_enabled = true           # SSE 스트리밍 응답 사용

# --- (전환 중) 기존 LibreChat 임베드 연동 — Phase 3에서 제거 예정 ---
base_url = ""    # LibreChat 외부 URL (예: https://chat.dmslab.re.kr)
                 # 이 값은 frontend 의 PUBLIC_LIBRECHAT_BASE 로도 주입되어 CSP frame-src 에 포함됩니다
mongo_url = ""   # LibreChat MongoDB 읽기 전용 접속 URL (secret.yaml에서 주입, 예: mongodb://readonly:pass@host:27017/LibreChat)


[smtp]
# 이메일 전송 설정 (프로젝트 초대 기능에 사용)
enabled = false
host = ""                   # SMTP 서버 호스트 (예: smtp.gmail.com)
port = 587                  # SMTP 포트 (587 = STARTTLS, 465 = SSL)
username = ""               # SMTP 인증 사용자명
password = ""               # SMTP 인증 비밀번호 (secret.yaml에서 주입)
from_address = "noreply@afterglow.example.com"
from_name = "Afterglow"
use_tls = true              # STARTTLS 사용 여부

[smtp.invitation]
token_expiry_days = 7       # 초대 링크 유효 기간 (일)


[cors]
# CORS 허용 origin (쉼표 구분). 프론트엔드 실제 접근 URL로 설정.
# 이 값이 S3 직접 업로드(multipart) 시 RGW quarantine 버킷 CORS 의 AllowedOrigins 로도 사용됨.
# 프로덕션 도메인을 첫 번째로, 개발 도메인을 이후에 나열.
# 예: origins = "https://cloud.dmslab.re.kr,http://localhost:3080,http://127.0.0.1:3080"
origins = "https://afterglow.example.com,http://localhost:3080,http://127.0.0.1:3080"

[gitlab_oidc]
# GitLab OIDC 로그인 활성화 여부
enabled = false
# GitLab 인스턴스 URL
gitlab_url = "https://gitlab.com"
# GitLab OAuth2 Application Client ID / Secret
client_id = ""
client_secret = ""
# Keystone OS-FEDERATION에 등록된 Identity Provider ID / Protocol ID
idp_id = "gitlab"
protocol_id = "openid"
# OAuth2 콜백 URL (프론트엔드 주소 + /auth/gitlab/callback)
redirect_uri = "http://localhost:3000/auth/gitlab/callback"
# GitLab OAuth2 scope
scopes = "openid email profile read_user"

{
  "__inputs": [],
  "__requires": [
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "node_exporter 기반 하이퍼바이저 노드 메트릭",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list"}},
      "targets": [
        {
          "expr": "1 - avg by(instance) (rate(node_cpu_seconds_total{mode='idle', instance=~'$instance'}[5m]))",
          "legendFormat": "{{instance}} CPU",
          "refId": "A"
        }
      ],
      "title": "CPU 사용률",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [
        {
          "expr": "1 - (node_memory_MemAvailable_bytes{instance=~'$instance'} / node_memory_MemTotal_bytes{instance=~'$instance'})",
          "legendFormat": "{{instance}} RAM",
          "refId": "A"
        }
      ],
      "title": "메모리 사용률",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10},
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{instance=~'$instance', device!~'lo|vnet.*|tap.*|vxlan.*|br.*|virbr.*'}[5m])",
          "legendFormat": "{{instance}} {{device}} rx",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{instance=~'$instance', device!~'lo|vnet.*|tap.*|vxlan.*|br.*|virbr.*'}[5m])",
          "legendFormat": "{{instance}} {{device}} tx",
          "refId": "B"
        }
      ],
      "title": "네트워크 I/O",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10},
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [
        {
          "expr": "rate(node_disk_read_bytes_total{instance=~'$instance', device=~'sd.*|vd.*|nvme.*'}[5m])",
          "legendFormat": "{{instance}} {{device}} read",
          "refId": "A"
        },
        {
          "expr": "rate(node_disk_written_bytes_total{instance=~'$instance', device=~'sd.*|vd.*|nvme.*'}[5m])",
          "legendFormat": "{{instance}} {{device}} write",
          "refId": "B"
        }
      ],
      "title": "디스크 I/O",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "options": {"showHeader": true},
      "targets": [
        {
          "expr": "node_load1{instance=~'$instance'}",
          "legendFormat": "{{instance}} load1",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "node_load5{instance=~'$instance'}",
          "legendFormat": "{{instance}} load5",
          "refId": "B",
          "instant": true
        }
      ],
      "title": "Load Average",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["afterglow", "node-exporter"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {"type": "prometheus"},
        "definition": "label_values(node_uname_info, instance)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "instance",
        "options": [],
        "query": "label_values(node_uname_info, instance)",
        "refresh": 2,
        "type": "query",
        "label": "Instance"
      },
      {
        "current": {"selected": true, "text": "Prometheus", "value": "Prometheus"},
        "hide": 2,
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Afterglow — Node Exporter",
  "uid": "afterglow-node",
  "version": 1
}

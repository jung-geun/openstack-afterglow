{
  "__inputs": [],
  "__requires": [
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "mysqld_exporter 기반 MySQL/MariaDB 메트릭",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row", "title": "Overview", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "panels": []
    },
    {
      "type": "stat", "title": "가동 시간",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "mappings": [], "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1}, "id": 1,
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "avg(mysql_global_status_uptime{instance=~'$instance'})",
         "legendFormat": "", "refId": "A", "instant": true}
      ]
    },
    {
      "type": "stat", "title": "현재 연결",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "text", "value": null},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 200}
            ]
          },
          "mappings": [], "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1}, "id": 2,
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "sum(mysql_global_status_threads_connected{instance=~'$instance'})",
         "legendFormat": "", "refId": "A", "instant": true}
      ]
    },
    {
      "type": "stat", "title": "평균 QPS",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "mappings": [], "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1}, "id": 3,
      "options": {
        "colorMode": "value", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["mean"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "avg(rate(mysql_global_status_queries{instance=~'$instance'}[5m]))",
         "legendFormat": "", "refId": "A"}
      ]
    },
    {
      "type": "stat", "title": "슬로우 쿼리 (1h)",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 100}
            ]
          },
          "mappings": [], "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1}, "id": 4,
      "options": {
        "colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "sum(increase(mysql_global_status_slow_queries{instance=~'$instance'}[1h]))",
         "legendFormat": "", "refId": "A", "instant": true}
      ]
    },
    {
      "type": "row", "title": "Throughput", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 101, "panels": []
    },
    {
      "type": "timeseries", "title": "QPS / TPS",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "id": 5,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "rate(mysql_global_status_queries{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} QPS", "refId": "A"},
        {"expr": "rate(mysql_global_status_com_commit{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} commits/s", "refId": "B"},
        {"expr": "rate(mysql_global_status_com_rollback{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} rollbacks/s", "refId": "C"}
      ]
    },
    {
      "type": "timeseries", "title": "핸들러 (read / write)",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "id": 6,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "rate(mysql_global_status_handler_read_rnd_next{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} read_rnd_next", "refId": "A"},
        {"expr": "rate(mysql_global_status_handler_write{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} write", "refId": "B"},
        {"expr": "rate(mysql_global_status_handler_update{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} update", "refId": "C"},
        {"expr": "rate(mysql_global_status_handler_delete{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} delete", "refId": "D"}
      ]
    },
    {
      "type": "row", "title": "Connections & Slow Queries", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}, "id": 102, "panels": []
    },
    {
      "type": "timeseries", "title": "연결 스레드",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15}, "id": 7,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "mysql_global_status_threads_connected{instance=~'$instance'}",
         "legendFormat": "{{instance}} connected", "refId": "A"},
        {"expr": "mysql_global_status_threads_running{instance=~'$instance'}",
         "legendFormat": "{{instance}} running", "refId": "B"},
        {"expr": "mysql_global_status_threads_cached{instance=~'$instance'}",
         "legendFormat": "{{instance}} cached", "refId": "C"},
        {"expr": "mysql_global_variables_max_connections{instance=~'$instance'}",
         "legendFormat": "{{instance}} max", "refId": "D"}
      ]
    },
    {
      "type": "timeseries", "title": "슬로우 쿼리율",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15}, "id": 8,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "rate(mysql_global_status_slow_queries{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} slow/s", "refId": "A"},
        {"expr": "rate(mysql_global_status_queries{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} total/s", "refId": "B"}
      ]
    },
    {
      "type": "row", "title": "InnoDB", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}, "id": 103, "panels": []
    },
    {
      "type": "gauge", "title": "InnoDB Buffer Pool 사용률",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.7},
              {"color": "red", "value": 0.9}
            ]
          },
          "mappings": [], "unit": "percentunit", "min": 0, "max": 1
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}, "id": 9,
      "options": {
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": true},
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "targets": [
        {"expr": "mysql_global_status_innodb_buffer_pool_pages_data{instance=~'$instance'} / mysql_global_status_innodb_buffer_pool_pages_total{instance=~'$instance'}",
         "legendFormat": "{{instance}}", "refId": "A", "instant": true}
      ]
    },
    {
      "type": "timeseries", "title": "InnoDB Row Operations",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}, "id": 10,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "rate(mysql_global_status_innodb_row_ops_total{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} {{operation}}", "refId": "A"}
      ]
    },
    {
      "type": "row", "title": "Network & Replication", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}, "id": 104, "panels": []
    },
    {
      "type": "timeseries", "title": "네트워크 처리량",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33}, "id": 11,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "rate(mysql_global_status_bytes_received{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} rx", "refId": "A"},
        {"expr": "rate(mysql_global_status_bytes_sent{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} tx", "refId": "B"}
      ]
    },
    {
      "type": "timeseries", "title": "Replication Lag",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33}, "id": 12,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "mysql_slave_status_seconds_behind_master{instance=~'$instance'}",
         "legendFormat": "{{instance}} lag", "refId": "A"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["afterglow", "mysql"],
  "templating": {
    "list": [
      {
        "current": {"selected": true, "text": "Prometheus", "value": "Prometheus"},
        "hide": 2,
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {"type": "prometheus"},
        "definition": "label_values(mysql_up, instance)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "instance",
        "options": [],
        "query": "label_values(mysql_up, instance)",
        "refresh": 2,
        "type": "query",
        "label": "Instance"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Afterglow — MySQL",
  "uid": "afterglow-mysqld",
  "version": 1
}

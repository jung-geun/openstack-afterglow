{
  "__inputs": [],
  "__requires": [
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "RabbitMQ Prometheus exporter 메트릭 (rabbitmq_prometheus plugin)",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {
          "expr": "sum by (instance) (rabbitmq_connections{instance=~'$instance'})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "연결 수",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [
        {
          "expr": "sum by (instance) (rabbitmq_channels{instance=~'$instance'})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "채널 수",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [
        {
          "expr": "sum by (instance) (rabbitmq_queues{instance=~'$instance'})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "큐 수",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "targets": [
        {
          "expr": "rate(rabbitmq_messages_published_total{instance=~'$instance'}[5m])",
          "legendFormat": "{{instance}} published",
          "refId": "A"
        },
        {
          "expr": "rate(rabbitmq_messages_delivered_total{instance=~'$instance'}[5m])",
          "legendFormat": "{{instance}} delivered",
          "refId": "B"
        }
      ],
      "title": "메시지 처리율 (msg/s)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "targets": [
        {
          "expr": "rabbitmq_queue_messages{instance=~'$instance'}",
          "legendFormat": "{{instance}} {{queue}}",
          "refId": "A"
        }
      ],
      "title": "큐 메시지 수",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["afterglow", "rabbitmq"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {"type": "prometheus"},
        "definition": "label_values(rabbitmq_identity_info, instance)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "instance",
        "options": [],
        "query": "label_values(rabbitmq_identity_info, instance)",
        "refresh": 2,
        "type": "query",
        "label": "Instance"
      },
      {
        "current": {"selected": true, "text": "Prometheus", "value": "Prometheus"},
        "hide": 2,
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Afterglow — RabbitMQ",
  "uid": "afterglow-rabbitmq",
  "version": 1
}

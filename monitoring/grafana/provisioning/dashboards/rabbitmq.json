{
  "__inputs": [],
  "__requires": [
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "RabbitMQ Prometheus exporter 메트릭 (rabbitmq_prometheus plugin)",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row", "title": "Overview", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "panels": []
    },
    {
      "type": "stat", "title": "노드 수",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "mappings": [], "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1}, "id": 1,
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "count(rabbitmq_identity_info{instance=~'$instance'})",
         "legendFormat": "", "refId": "A", "instant": true}
      ]
    },
    {
      "type": "stat", "title": "연결 수",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "mappings": [], "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1}, "id": 2,
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "sum(rabbitmq_connections{instance=~'$instance'})",
         "legendFormat": "", "refId": "A", "instant": true}
      ]
    },
    {
      "type": "stat", "title": "채널 수",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "mappings": [], "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1}, "id": 3,
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "sum(rabbitmq_channels{instance=~'$instance'})",
         "legendFormat": "", "refId": "A", "instant": true}
      ]
    },
    {
      "type": "stat", "title": "큐 수",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "mappings": [], "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1}, "id": 4,
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "sum(rabbitmq_queues{instance=~'$instance'})",
         "legendFormat": "", "refId": "A", "instant": true}
      ]
    },
    {
      "type": "row", "title": "Message Throughput", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 101, "panels": []
    },
    {
      "type": "timeseries", "title": "메시지 처리율 (msg/s)",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "id": 5,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "rate(rabbitmq_messages_published_total{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} published", "refId": "A"},
        {"expr": "rate(rabbitmq_messages_delivered_total{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} delivered", "refId": "B"},
        {"expr": "rate(rabbitmq_messages_acknowledged_total{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} acked", "refId": "C"},
        {"expr": "rate(rabbitmq_messages_redelivered_total{instance=~'$instance'}[5m])",
         "legendFormat": "{{instance}} redelivered", "refId": "D"}
      ]
    },
    {
      "type": "timeseries", "title": "메시지 상태 (ready / unacked)",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "lineWidth": 1, "fillOpacity": 40, "spanNulls": false, "showPoints": "never",
            "stacking": {"mode": "normal", "group": "A"}
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "id": 6,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "sum by (instance) (rabbitmq_queue_messages_ready{instance=~'$instance'})",
         "legendFormat": "{{instance}} ready", "refId": "A"},
        {"expr": "sum by (instance) (rabbitmq_queue_messages_unacknowledged{instance=~'$instance'})",
         "legendFormat": "{{instance}} unacked", "refId": "B"}
      ]
    },
    {
      "type": "row", "title": "Queue Depth", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}, "id": 102, "panels": []
    },
    {
      "type": "table", "title": "큐별 메시지 수",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 15}, "id": 7,
      "options": {
        "showHeader": true,
        "sortBy": [{"displayName": "Value", "desc": true}]
      },
      "targets": [
        {"expr": "sort_desc(rabbitmq_queue_messages{instance=~'$instance'})",
         "legendFormat": "{{instance}} — {{queue}}", "refId": "A", "instant": true,
         "format": "table"}
      ]
    },
    {
      "type": "row", "title": "Node Resources", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}, "id": 103, "panels": []
    },
    {
      "type": "timeseries", "title": "노드 메모리",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}, "id": 8,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "rabbitmq_process_resident_memory_bytes{instance=~'$instance'}",
         "legendFormat": "{{instance}} resident", "refId": "A"},
        {"expr": "rabbitmq_resident_memory_limit_bytes{instance=~'$instance'}",
         "legendFormat": "{{instance}} limit", "refId": "B"}
      ]
    },
    {
      "type": "timeseries", "title": "디스크 여유 공간",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}, "id": 9,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "min"]}
      },
      "targets": [
        {"expr": "rabbitmq_disk_space_available_bytes{instance=~'$instance'}",
         "legendFormat": "{{instance}} available", "refId": "A"},
        {"expr": "rabbitmq_disk_space_available_limit_bytes{instance=~'$instance'}",
         "legendFormat": "{{instance}} limit", "refId": "B"}
      ]
    },
    {
      "type": "row", "title": "Erlang VM", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}, "id": 104, "panels": []
    },
    {
      "type": "timeseries", "title": "Erlang 프로세스",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33}, "id": 10,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "erlang_vm_process_count{instance=~'$instance'}",
         "legendFormat": "{{instance}} count", "refId": "A"},
        {"expr": "erlang_vm_process_limit{instance=~'$instance'}",
         "legendFormat": "{{instance}} limit", "refId": "B"}
      ]
    },
    {
      "type": "timeseries", "title": "File Descriptor 사용량",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33}, "id": 11,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "rabbitmq_process_open_fds{instance=~'$instance'}",
         "legendFormat": "{{instance}} open", "refId": "A"},
        {"expr": "rabbitmq_process_max_fds{instance=~'$instance'}",
         "legendFormat": "{{instance}} max", "refId": "B"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["afterglow", "rabbitmq"],
  "templating": {
    "list": [
      {
        "current": {"selected": true, "text": "Prometheus", "value": "Prometheus"},
        "hide": 2,
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {"type": "prometheus"},
        "definition": "label_values(rabbitmq_identity_info, instance)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "instance",
        "options": [],
        "query": "label_values(rabbitmq_identity_info, instance)",
        "refresh": 2,
        "type": "query",
        "label": "Instance"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Afterglow — RabbitMQ",
  "uid": "afterglow-rabbitmq",
  "version": 1
}

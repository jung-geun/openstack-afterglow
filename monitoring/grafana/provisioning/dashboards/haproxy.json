{
  "__inputs": [],
  "__requires": [
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "haproxy_exporter를 통해 수집된 HAProxy 메트릭",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row", "title": "Overview", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "panels": []
    },
    {
      "type": "stat", "title": "인스턴스 수",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "mappings": [], "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1}, "id": 1,
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "count(haproxy_up{instance=~'$instance'})",
         "legendFormat": "", "refId": "A", "instant": true}
      ]
    },
    {
      "type": "stat", "title": "가동 상태",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          },
          "mappings": [
            {"options": {"0": {"text": "Down"}, "1": {"text": "Up"}}, "type": "value"}
          ],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1}, "id": 2,
      "options": {
        "colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "min(haproxy_up{instance=~'$instance'})",
         "legendFormat": "", "refId": "A", "instant": true}
      ]
    },
    {
      "type": "stat", "title": "활성 프론트엔드",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "mappings": [], "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1}, "id": 3,
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "count(haproxy_frontend_current_sessions{instance=~'$instance'})",
         "legendFormat": "", "refId": "A", "instant": true}
      ]
    },
    {
      "type": "stat", "title": "백엔드 서비스 수",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]},
          "mappings": [], "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1}, "id": 4,
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {"expr": "count(count by (proxy) (haproxy_backend_status{instance=~'$instance'}))",
         "legendFormat": "", "refId": "A", "instant": true}
      ]
    },
    {
      "type": "row", "title": "Sessions", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 101, "panels": []
    },
    {
      "type": "timeseries", "title": "현재 세션 수",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "id": 5,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "haproxy_frontend_current_sessions{instance=~'$instance'}",
         "legendFormat": "fe/{{proxy}}", "refId": "A"},
        {"expr": "haproxy_backend_current_sessions{instance=~'$instance'}",
         "legendFormat": "be/{{proxy}}", "refId": "B"}
      ]
    },
    {
      "type": "timeseries", "title": "신규 HTTP 요청율",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "id": 6,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "rate(haproxy_frontend_http_requests_total{instance=~'$instance'}[5m])",
         "legendFormat": "{{proxy}}", "refId": "A"}
      ]
    },
    {
      "type": "row", "title": "Traffic", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}, "id": 102, "panels": []
    },
    {
      "type": "timeseries", "title": "네트워크 입출력",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15}, "id": 7,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "rate(haproxy_frontend_bytes_in_total{instance=~'$instance'}[5m])",
         "legendFormat": "{{proxy}} in", "refId": "A"},
        {"expr": "rate(haproxy_frontend_bytes_out_total{instance=~'$instance'}[5m])",
         "legendFormat": "{{proxy}} out", "refId": "B"}
      ]
    },
    {
      "type": "timeseries", "title": "HTTP 응답 코드별 처리율",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 20, "spanNulls": false, "showPoints": "never", "stacking": {"mode": "normal", "group": "A"}},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15}, "id": 8,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "sum by (code) (rate(haproxy_frontend_http_responses_total{instance=~'$instance'}[5m]))",
         "legendFormat": "{{code}}xx", "refId": "A"}
      ]
    },
    {
      "type": "row", "title": "Backend Health", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}, "id": 103, "panels": []
    },
    {
      "type": "timeseries", "title": "백엔드 평균 응답 시간",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}, "id": 9,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "haproxy_backend_response_time_average_seconds{instance=~'$instance'}",
         "legendFormat": "{{proxy}}", "refId": "A"}
      ]
    },
    {
      "type": "timeseries", "title": "백엔드 큐 대기",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}, "id": 10,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "haproxy_backend_current_queue{instance=~'$instance'}",
         "legendFormat": "{{proxy}}", "refId": "A"}
      ]
    },
    {
      "type": "row", "title": "Errors & Server Status", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}, "id": 104, "panels": []
    },
    {
      "type": "timeseries", "title": "연결 오류율",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "showPoints": "never"},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33}, "id": 11,
      "options": {
        "tooltip": {"mode": "multi", "sort": "none"},
        "legend": {"displayMode": "list", "placement": "bottom", "calcs": ["mean", "last", "max"]}
      },
      "targets": [
        {"expr": "rate(haproxy_frontend_connection_errors_total{instance=~'$instance'}[5m])",
         "legendFormat": "fe/{{proxy}}", "refId": "A"},
        {"expr": "rate(haproxy_backend_connection_errors_total{instance=~'$instance'}[5m])",
         "legendFormat": "be/{{proxy}}", "refId": "B"}
      ]
    },
    {
      "type": "table", "title": "서버 상태",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          },
          "mappings": [
            {"options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}, "type": "value"}
          ],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33}, "id": 12,
      "options": {
        "showHeader": true,
        "footer": {"show": false, "reducer": ["sum"], "countRows": false, "fields": ""}
      },
      "targets": [
        {"expr": "haproxy_server_status{instance=~'$instance'}",
         "legendFormat": "{{proxy}} / {{server}}", "refId": "A", "instant": true,
         "format": "table"}
      ],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"__name__": true, "job": true}, "renameByName": {"proxy": "Proxy", "server": "Server", "Value": "Status"}}}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["afterglow", "haproxy"],
  "templating": {
    "list": [
      {
        "current": {"selected": true, "text": "Prometheus", "value": "Prometheus"},
        "hide": 2,
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {"type": "prometheus"},
        "definition": "label_values(haproxy_up, instance)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "instance",
        "options": [],
        "query": "label_values(haproxy_up, instance)",
        "refresh": 2,
        "type": "query",
        "label": "Instance"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Afterglow — HAProxy",
  "uid": "afterglow-haproxy",
  "version": 1
}
